# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this as a server secret; never commit a real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public backend URL used by the Vite frontend after deployment.
# Example: https://verigrocery-api.onrender.com
VITE_API_BASE_URL="http://localhost:4000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
